package main

// Windows XP Luna window control button (minimize, maximize, close):
// white outer rounded frame, glossy 3D gradient and top-left highlight.

var State vec4

// The base button color (blue for min/max, orange-red for close).
//gorex:param color #1e5cd6
var Base vec3

func sdRBox(p, b vec2, r float) float {
	q := abs(p) - b + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	half := s * 0.5
	d := sdRBox(pos-half, half-0.5, 3.0)
	if d > 0.5 {
		return vec4(0, 0, 0, 0)
	}

	// White outer rounded border (1 px)
	if d > -0.8 {
		return vec4(1, 1, 1, 1)
	}

	uv := clamp(pos/max(s, vec2(1)), 0, 1)
	diag := clamp((uv.x+uv.y)*0.5, 0, 1)
	hi := mix(Base, vec3(1, 1, 1), 0.06)
	lo := Base * 0.65
	c := mix(hi, Base, clamp(diag/0.55, 0, 1))
	if diag > 0.55 {
		c = mix(Base, lo, clamp((diag-0.55)/0.45, 0, 1))
	}

	// Soft top-left specular dot (away from sample edges)
	glow := exp(-dot(uv-vec2(0.32, 0.35), uv-vec2(0.32, 0.35)) * 36.0)
	c = mix(c, vec3(1, 1, 1), glow*0.18)

	if State.y > 0.5 {
		// Clicked: deeper gradient + dark top-left inner shadow
		c = Base * 0.72
		if pos.x < 3.5 || pos.y < 3.5 {
			c = c * 0.65
		}
	} else if State.x > 0.5 {
		// Hover: brighter + bottom-right glow
		c = mix(c, vec3(1, 1, 1), 0.22)
		br := exp(-dot(uv-vec2(0.8, 0.8), uv-vec2(0.8, 0.8)) * 12.0)
		c = mix(c, mix(Base, vec3(1, 1, 1), 0.45), br*0.45)
	}

	// Subtle dark inner rim
	if d > -1.8 {
		c = mix(c, Base*0.45, 0.45)
	}
	return vec4(c, 1)
}
