package main

// Windows XP Luna button:
// - Normal: white-to-cream vertical gradient, 1 px #003c74 border, bottom bevel
// - Hover (State.x): 2 px orange inner ring (#f8b333 / #fcd37b)
// - Focus/Primary (State.z): 2 px blue inner ring (#699de7 / #9ec2f7)
// - Pressed (State.y): inverted bevel gradient
// - Disabled (State.w): flat #f5f4ea with #c9c7ba border

var State vec4

func sdRBox(p, b vec2, r float) float {
	q := abs(p) - b + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	half := s * 0.5
	d := sdRBox(pos-half, half-0.5, 2.5)
	if d > 0.5 {
		return vec4(0, 0, 0, 0)
	}

	y := clamp(pos.y/max(s.y, 1), 0, 1)

	// Disabled
	if State.w > 0.5 {
		c := vec3(0.961, 0.957, 0.918) // #f5f4ea
		if d > -0.7 {
			c = vec3(0.788, 0.780, 0.729) // #c9c7ba
		}
		return vec4(c, 1)
	}

	var c vec3
	if State.y > 0.5 {
		// Pressed: #e5e4dd -> #e0e0d7 with top-left warm inner shadow
		top := vec3(0.898, 0.894, 0.867)
		bot := vec3(0.878, 0.878, 0.843)
		c = mix(top, bot, y)
		if pos.x < 3.0 || pos.y < 3.5 {
			c = mix(c, vec3(0.325, 0.216, 0.0), 0.16)
		}
	} else {
		// Normal / Hover / Focus: #ffffff -> #f0f0ea
		top := vec3(1.0, 1.0, 1.0)
		bot := vec3(0.941, 0.941, 0.918)
		c = mix(top, bot, y)
		// Bottom-right warm bevel shadow (rgba(83,55,0,0.2)) and top-left white highlight
		if s.y-pos.y < 3.0 || s.x-pos.x < 2.2 {
			t := max(clamp((3.0-(s.y-pos.y))/2.3, 0, 1), clamp((2.2-(s.x-pos.x))/1.5, 0, 1))
			c = mix(c, vec3(0.325, 0.216, 0.0), 0.20*t)
		}
		if pos.x < 2.5 || pos.y < 2.5 {
			c = mix(c, vec3(1.0, 1.0, 1.0), 0.75)
		}
		// Hover orange inner ring (#fbca6a), or Primary/Focused blue inner ring (#93b3e7)
		if d > -2.8 && d <= -0.7 {
			t := clamp((-0.7 - d) / 2.1, 0, 1)
			if State.x > 0.5 {
				c = mix(c, vec3(0.984, 0.792, 0.416), 0.92*(1.0-t*0.2))
			} else if State.z > 0.5 {
				c = mix(c, vec3(0.576, 0.702, 0.906), 0.92*(1.0-t*0.2))
			}
		}
	}

	// 1 px outer XP border (#1c5180)
	if d > -0.7 {
		c = vec3(0.110, 0.318, 0.502)
	}
	return vec4(c, 1)
}
