package main

// Windows XP Luna button:
// - Normal: white-to-cream vertical gradient, 1 px #003c74 border, bottom bevel
// - Hover (State.x): 2 px orange inner ring (#f8b333 / #fcd37b)
// - Focus/Primary (State.z): 2 px blue inner ring (#699de7 / #9ec2f7)
// - Pressed (State.y): inverted bevel gradient
// - Disabled (State.w): flat #f5f4ea with #c9c7ba border

var State vec4

func sdRBox(p, b vec2, r float) float {
	q := abs(p) - b + r
	return length(max(q, 0)) + min(max(q.x, q.y), 0) - r
}

func Fragment(dst vec4, pos vec2) vec4 {
	s := rectSize()
	half := s * 0.5
	d := sdRBox(pos-half, half-0.5, 2.5)
	if d > 0.5 {
		return vec4(0, 0, 0, 0)
	}

	y := clamp(pos.y/max(s.y, 1), 0, 1)

	// Disabled
	if State.w > 0.5 {
		c := vec3(0.961, 0.957, 0.918) // #f5f4ea
		if d > -0.7 {
			c = vec3(0.788, 0.780, 0.729) // #c9c7ba
		}
		return vec4(c, 1)
	}

	var c vec3
	if State.y > 0.5 {
		// Pressed: slightly darker warm gray with top inner shadow
		top := vec3(0.820, 0.812, 0.769) // #d1cfc4
		mid := vec3(0.898, 0.894, 0.863) // #e5e4dc
		bot := vec3(0.925, 0.922, 0.886) // #ecebe2
		c = mix(top, mid, clamp(y/0.35, 0, 1))
		if y > 0.35 {
			c = mix(mid, bot, clamp((y-0.35)/0.65, 0, 1))
		}
	} else {
		// Normal / Hover / Focus
		top := vec3(1.0, 1.0, 1.0)
		mid := vec3(0.961, 0.957, 0.937) // #f5f4ef
		bot := vec3(0.847, 0.835, 0.788) // #d8d5c9
		c = mix(top, mid, clamp(y/0.75, 0, 1))
		if y > 0.75 {
			c = mix(mid, bot, clamp((y-0.75)/0.25, 0, 1))
		}
		// Hover orange inner ring, or Primary/Focused blue inner ring
		if d > -2.6 && d <= -0.7 {
			t := clamp((-0.7 - d) / 1.9, 0, 1)
			if State.x > 0.5 {
				outer := vec3(0.973, 0.702, 0.200) // #f8b333
				inner := vec3(0.988, 0.827, 0.482) // #fcd37b
				c = mix(c, mix(outer, inner, t), 0.9)
			} else if State.z > 0.5 {
				outer := vec3(0.412, 0.616, 0.906) // #699de7
				inner := vec3(0.620, 0.761, 0.969) // #9ec2f7
				c = mix(c, mix(outer, inner, t), 0.88)
			}
		}
	}

	// 1 px outer XP navy border (#003c74)
	if d > -0.7 {
		c = vec3(0.0, 0.235, 0.455)
	}
	return vec4(c, 1)
}
