package main

var State vec4

func Fragment(dst vec4, pos vec2) vec4 {
	size := rectSize()
	uv := pos / size
	dEdge := min(min(pos.x, size.x-pos.x), min(pos.y, size.y-pos.y))

	hovered := State.x > 0.5
	pressed := State.y > 0.5
	disabled := State.w > 0.5

	if disabled {
		if dEdge < 1.0 {
			return vec4(0.792, 0.784, 0.733, 1.0) // #CAC8BB
		}
		return vec4(1.0, 1.0, 1.0, 1.0)
	}

	if dEdge < 1.0 {
		return vec4(0.110, 0.318, 0.502, 1.0) // #1C5180
	}

	t := clamp((uv.x+uv.y)*0.5, 0.0, 1.0)
	var col vec3
	if pressed {
		col = mix(vec3(0.690, 0.686, 0.635), vec3(0.898, 0.894, 0.855), t)
	} else {
		col = mix(vec3(0.863, 0.863, 0.839), vec3(1.0, 1.0, 1.0), t)
		if hovered && dEdge < 3.0 {
			ring := mix(vec3(0.957, 0.722, 0.243), vec3(0.988, 0.827, 0.467), clamp((dEdge-1.0)/2.0, 0.0, 1.0))
			col = ring
		}
	}
	return vec4(col, 1.0)
}
