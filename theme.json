      "checkbox.background": {
        "source": "checkbox"
      },
      "radio.background": {
        "source": "radio"
      },
      "windowControl.background": {
        "source": "winctrl",
        "params": {
          "Base": "#1d56e0"
        }
      },
      "windowControl.closeBackground": {
        "source": "winctrl",
        "params": {
          "Base": "#ba2c0c"
        }
      }
    }
  },
  "metrics": {
    "radius": 0.2,
    "border": 1,
    "font": [
      "Tahoma",
      "Segoe UI",
      "system"
    ],
    "shadow": {
      "scale": 0.5
